# Copie para .env e preencha. Nunca commite o .env.

# Provedor do LLM: openai | anthropic | google | ollama
LLM_PROVIDER=openai
# Nome do modelo do provedor escolhido (ex.: o modelo barato/rápido do provedor)
LLM_MODEL=

# Chave do provedor escolhido (preencha só a que usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Para ollama: OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Opcional: tracing com LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

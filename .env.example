# Copie para .env e preencha. Nunca commite o .env.

# Provedor do LLM: openai | anthropic | google | ollama
LLM_PROVIDER=google
# Nome do modelo do provedor escolhido (ex.: o modelo barato/rápido do provedor)
# Modelos 2.5 não estão disponíveis para chaves novas do Google.
LLM_MODEL=gemini-3.1-flash-lite
# Alternativas: gemini-3.5-flash-lite e gemini-3.5-flash. No plano gratuito a cota é diária
# por modelo e por projeto (ex.: 500/dia nos "lite", 20/dia no gemini-3.5-flash).

# Modelos de reserva (vírgulas), tentados em ordem se o principal falhar por cota/crédito
# (429/402), erro do servidor ou indisponibilidade (500/503/504), timeout ou falha de conexão.
# Saída inválida não troca de modelo. Vazio desativa a troca automática.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Chave do provedor escolhido (preencha só a que usar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Para ollama: OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Opcional: pasta do índice Chroma. No Windows o Chroma exige caminho ASCII; se o
# nome curto 8.3 do projeto não estiver disponível, aponte para uma pasta só ASCII.
# CHROMA_DIR=C:\chroma_olist

# Opcional: tracing com LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
